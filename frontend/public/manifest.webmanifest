{
  "id": "/",
  "name": "AbyEx",
  "short_name": "AbyEx",
  "description": "Track expenses, wallets, debts and budgets, with reminders that find you.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
