{
  "expo": {
    "name": "Rabbit Tracker",
    "slug": "expense-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/rabbit-icon.png",
    "scheme": "expensetracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.abyride.expensetracker",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "icon": "./assets/images/logo/rabbit-icon.png",
      "usesAppleSignIn": true,
      "associatedDomains": ["webcredentials:aby-expense.onrender.com"]
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#00627F",
        "foregroundImage": "./assets/images/logo/rabbit-adaptive.png",
        "monochromeImage": "./assets/images/logo/rabbit-adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abyride.expensetracker"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo/rabbit-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo/rabbit.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#00627F",
          "dark": {
            "image": "./assets/images/logo/rabbit.png",
            "backgroundColor": "#00627F"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo/notification-icon.png",
          "color": "#00627F",
          "sounds": [
            "./assets/sounds/chime.wav",
            "./assets/sounds/bell.wav",
            "./assets/sounds/pop.wav",
            "./assets/sounds/ding.wav"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "16.4" },
          "android": { "compileSdkVersion": 36 }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ec71afa-28f9-48d1-963d-ca83673d1979"
      }
    }
  }
}
