generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum NotificationType {
  transaction
  security
  system
}

enum NotificationChannel {
  push
  email
  in_app
}

model Client {
  id                     String                  @id @default(uuid())
  firstName              String
  lastName               String?
  email                  String                  @unique
  phone                  String                  @unique
  googleId               String?                 @unique
  appleId                String?                 @unique
  facebookId             String?                 @unique
  passwordHash           String?
  isVerified             Boolean                 @default(false)
  profileImage           String?
  isActive               Boolean                 @default(true)
  isBiometric            Boolean                 @default(false)
  isFaceRecognition      Boolean                 @default(false)
  faceDescriptor         Json?
  emailOtp               String?
  emailOtpExpiry         DateTime?
  emailVerifiedAt        DateTime?
  phoneVerifiedAt        DateTime?
  phoneOtp               String?
  phoneOtpExpiry         DateTime?
  refreshTokens          RefreshToken[]
  devices                Device[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  wallets                Wallet[]
  transactions           Transaction[]
  budgets                Budget[]
  debts                  Debt[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model RefreshToken {
  id           String   @id @default(uuid())
  selector     String   @unique
  verifierHash String
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Device {
  id           String   @id @default(uuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deviceName   String
  platform     String
  pushToken    String?
  channelId    String?
  sound        String?
  ipAddress    String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([clientId])
}

model Notification {
  id        String              @id @default(uuid())
  clientId  String
  client    Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      NotificationType
  channel   NotificationChannel
  read      Boolean             @default(false)
  data      Json?
  createdAt DateTime            @default(now())

  @@index([clientId])
}

model NotificationPreference {
  id           String  @id @default(uuid())
  clientId     String  @unique
  client       Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pushEnabled  Boolean @default(true)
  emailEnabled Boolean @default(true)
  inAppEnabled Boolean @default(true)
}

// ── Expense Tracker Models ─────────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  DEBT
}

enum CategorySlug {
  food
  transport
  shopping
  health
  entertainment
  travel
  groceries
  salary
  other
  bills
  rent
  utilities
  education
  family
  gifts
  business
  investment
  subscriptions
  personal_care
  fuel
  insurance
  savings
  freelance
  refund
  loan
}

enum WalletType {
  CHECKING
  SAVINGS
  CREDIT
  CASH
  MOBILE_MONEY
}

model Wallet {
  id           String        @id @default(uuid())
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  bank         String
  last4        String?
  accountHolder String?
  accountNumber String?
  color        String        @default("#0F2F3A")
  currency     String        @default("RWF")
  archived     Boolean       @default(false)
  walletType   WalletType    @default(CHECKING)
  balance      Decimal       @default(0) @db.Decimal(12, 2)
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@index([clientId])
}

model Transaction {
  id          String          @id @default(uuid())
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  walletId    String?
  wallet      Wallet?         @relation(fields: [walletId], references: [id], onDelete: SetNull)
  type        TransactionType
  category    CategorySlug
  title       String
  description String?
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime        @default(now())
  receiptUrl  String?
  // TRANSFER only: money moves from walletId to toWalletId
  toWalletId   String?
  toAmount     Decimal?        @db.Decimal(12, 2)
  exchangeRate Decimal?        @db.Decimal(18, 8)
  // DEBT only: money borrowed / lent / repaid for this debt
  debtId       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([clientId])
  @@index([clientId, date])
  @@index([debtId])
}

model Budget {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month     Int
  year      Int
  limit     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, month, year])
  @@index([clientId])
}

// ── Debts & loans ──────────────────────────────────────────────────────────

enum DebtKind {
  BORROWED // I owe someone
  LENT     // someone owes me
}

enum DebtStatus {
  OPEN
  SETTLED
}

model Debt {
  id        String        @id @default(uuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind      DebtKind
  person    String
  phone     String?
  amount    Decimal       @db.Decimal(12, 2)
  paid      Decimal       @default(0) @db.Decimal(12, 2)
  currency  String
  date      DateTime      @default(now())
  dueDate   DateTime?
  note      String?
  walletId  String?
  status    DebtStatus    @default(OPEN)
  payments  DebtPayment[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([clientId, status])
}

model DebtPayment {
  id            String   @id @default(uuid())
  debtId        String
  debt          Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount        Decimal  @db.Decimal(12, 2)
  date          DateTime @default(now())
  walletId      String?
  transactionId String?
  note          String?
  createdAt     DateTime @default(now())

  @@index([debtId])
}
